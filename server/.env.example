# ── Required ─────────────────────────────────────────────────────────────────

# Admin login password, stored as a bcrypt hash (never the password itself).
# The server refuses to seed an admin user in production without this.
# Generate one with:
#   node -e "require('bcryptjs').hash('your-password-here', 12).then(console.log)"
ADMIN_PASSWORD_HASH=

# Signs admin session tokens. Must be unique and at least 16 characters; the
# server refuses to start in production otherwise. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing this logs every admin session out.
JWT_SECRET=

# Encrypts the stored Google OAuth tokens. Same length rules as JWT_SECRET.
# Generate it the same way — but with a DIFFERENT value.
# Do not change this on a running deployment: the stored tokens were encrypted
# with the old value and become unreadable, silently dropping the Google
# Calendar connection until you reconnect at /admin.
ENCRYPTION_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://yourdomain.com/auth/google/callback

# Origins allowed to call the API, comma separated. Set this to the public URL
# you actually serve, or admin requests are rejected. localhost and 127.0.0.1
# are always allowed, as is any request whose Origin matches the host it
# arrived on, so a normal single-domain deployment needs nothing here.
CORS_ORIGINS=https://yourdomain.com

# ── Optional ─────────────────────────────────────────────────────────────────

TIMEZONE=America/Chicago
PORT=5000
DATA_DIR=/app/data

# Number of proxies in front of the app, counted outwards. docker-compose sets
# this to 2 (nginx + Traefik). Per-IP rate limiting depends on it being exact;
# never set it to "true", which lets clients forge their own address.
TRUST_PROXY=

# Enables address autocomplete and the drive-time matrix in the admin panel.
GOOGLE_MAPS_API_KEY=

# Only needed for manual OAuth setup; connecting at /admin is the normal route.
GOOGLE_REFRESH_TOKEN=

# Where booking notifications to you are sent. Falls back to EMAIL_FROM, then
# SMTP_USER, so a normal SMTP setup needs nothing here.
ADMIN_EMAIL=

# ── Email (optional) ─────────────────────────────────────────────────────────
# Leave SMTP_HOST blank to disable email entirely. Google Calendar invites
# still go out; only the app's own confirmations and reminders are skipped.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false           # true for port 465, false for STARTTLS on 587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=                 # e.g. Tutoring <no-reply@example.com>
# Public site URL, used to build the manage links inside emails.
PUBLIC_BASE_URL=

# ── CAPTCHA on the public booking form (optional) ────────────────────────────
# Disabled unless BOTH keys are set.
CAPTCHA_PROVIDER=turnstile  # turnstile | hcaptcha
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET_KEY=

# ── Text messages (optional) ─────────────────────────────────────────────────
# Disabled unless ALL THREE are set. Independent of email: texts go out with
# SMTP_HOST blank. Three channels — a booking confirmation, a reschedule or
# cancellation notice, and a reminder before the session — each switched on
# separately in /admin → Settings → Text Messages. All go only to students who
# ticked the opt-in box. US numbers only.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Must be a number your Twilio account owns, in E.164. A wrong value here fails
# with Twilio error 21606.
TWILIO_FROM_NUMBER=         # e.g. +15551234567
